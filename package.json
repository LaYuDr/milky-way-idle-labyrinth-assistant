{
  "name": "milky-way-idle-labyrinth-assistant",
  "version": "0.12.11",
  "private": true,
  "description": "银河奶牛迷宫助手：规划迷宫路线，估算房间胜率与通关耗时，提供推荐等级与重开建议。",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "node tools/dev-server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\" \"tools/**/*.mjs\"",
    "test": "node --test test/*.test.js",
    "verify:repo": "node tools/verify-repository.mjs",
    "check": "node tools/check.mjs full",
    "check:quick": "node tools/check.mjs quick",
    "check:handoff": "node tools/check.mjs handoff",
    "check:ci": "node tools/check.mjs ci",
    "release": "node tools/release-current-version.mjs",
    "release:dry-run": "node tools/release-current-version.mjs --dry-run"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "globals": "17.9.0",
    "playwright": "^1.65.0",
    "prettier": "3.9.6"
  }
}
